{
  "expo": {
    "name": "ZARO GROUP",
    "slug": "zaro-group",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#b8922e"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zarogroup.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.zarogroup.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#b8922e"
      },
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE", "VIBRATE"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "PROJECT_ID"
      }
    }
  }
}